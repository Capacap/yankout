// yankout niri snippets. Both windows are fixed-size, which niri's
// heuristics float and centre on their own — rules are only needed
// where placement should differ from that default. Merge into
// ~/.config/niri/config.kdl and adjust to taste.

// window-rule {
//     match app-id=r#"^dev\.yankout\.(list|puck)$"#
//     open-floating true
// }

// Spawn bind (goes inside the binds block). Use a full path if
// ~/.cargo/bin is not on the niri session's PATH.
// Mod+Shift+C hotkey-overlay-title="Clipboard drag" { spawn "yankout"; }

// Native history watcher (top level, one per session). Replaces the
// `wl-paste --watch cliphist store` pair; anything that read `cliphist
// list` can read `yankout list` instead.
// spawn-at-startup "yankout" "watch"
